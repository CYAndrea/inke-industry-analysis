{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-industry-research-artifacts-v3",
  "schema_version": 3,
  "enums": {
    "research_mode": ["industry_overview", "public_company", "private_company", "competitive_scan"],
    "deliverable": ["飞书文档", "Word", "Excel", "PDF"],
    "capital_market_stage": ["primary_market", "secondary_market", "not_applicable"],
    "research_archetype": ["大消费品", "科技硬件", "工业制造", "软件平台", "服务与医疗", "其他"],
    "technology_materiality": ["非核心", "支持性", "核心护城河"],
    "company_maturity": ["早期验证", "增长期", "成熟未上市", "拟上市", "上市运营", "不适用"],
    "information_availability": ["稀疏", "部分", "充分"],
    "output_profile": [
      "industry_consumer", "industry_core_tech", "industry_consumer_core_tech",
      "industry_software_service", "industry_software_core_tech",
      "primary_consumer", "primary_core_tech", "primary_consumer_core_tech",
      "primary_software_service", "primary_software_core_tech",
      "secondary_consumer", "secondary_core_tech", "secondary_consumer_core_tech",
      "secondary_software_service", "secondary_software_core_tech"
    ],
    "evidence_type": ["fact", "reported_fact", "company_claim", "forecast", "estimate", "inference", "judgment", "to_verify"],
    "tier": ["A", "B", "C", "D"],
    "format": ["飞书文档", "Word", "Excel", "PDF"]
  },
  "$defs": {
    "evidence_ref": {"type": "string", "pattern": "^E[0-9]{2,4}$"},
    "routing": {
      "type": "object",
      "required": ["research_mode", "capital_market_stage", "research_archetype", "technology_materiality", "company_maturity", "information_availability", "output_profile"],
      "properties": {
        "research_mode": {"enum_ref": "research_mode"},
        "capital_market_stage": {"enum_ref": "capital_market_stage"},
        "research_archetype": {"enum_ref": "research_archetype"},
        "technology_materiality": {"enum_ref": "technology_materiality"},
        "company_maturity": {"enum_ref": "company_maturity"},
        "information_availability": {"enum_ref": "information_availability"},
        "output_profile": {"enum_ref": "output_profile"}
      }
    },
    "brief": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "industry_theme", "deliverable", "routing", "scope", "decision_question", "core_hypothesis", "mode_rationale", "disproof_conditions", "must_cover_clusters", "required_sections", "output_acceptance"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "brief"},
        "industry_theme": {"type": "string", "minLength": 2},
        "target_company": {"type": "string"},
        "deliverable": {"enum_ref": "deliverable"},
        "routing": {"$ref": "#/$defs/routing"},
        "scope": {"type": "object", "required": ["geography", "as_of"], "properties": {"geography": {"type": "array", "minItems": 1}, "as_of": {"type": "string", "minLength": 8}, "segments": {"type": "array"}}},
        "decision_question": {"type": "string", "minLength": 8},
        "core_hypothesis": {"type": "string", "minLength": 20},
        "mode_rationale": {"type": "string", "minLength": 8},
        "disproof_conditions": {"type": "array", "minItems": 1},
        "must_cover_clusters": {"type": "array", "minItems": 1},
        "required_sections": {"type": "array", "minItems": 1},
        "output_acceptance": {"type": "array", "minItems": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "claim", "evidence_type", "tier", "source_name", "source_title", "published_at", "url", "geography", "period", "unit", "scope", "calculation", "usage", "limitations", "source_role", "independence"],
      "properties": {
        "id": {"$ref": "#/$defs/evidence_ref"},
        "claim": {"type": "string", "minLength": 12},
        "evidence_type": {"enum_ref": "evidence_type"},
        "tier": {"enum_ref": "tier"},
        "source_name": {"type": "string", "minLength": 2},
        "source_title": {"type": "string", "minLength": 2},
        "published_at": {"type": "string", "minLength": 4},
        "url": {"type": "string", "pattern": "^https?://"},
        "geography": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 2},
        "calculation": {"type": "string", "minLength": 2},
        "usage": {"type": "string", "minLength": 2},
        "limitations": {"type": "string", "minLength": 2},
        "source_role": {"type": "string", "minLength": 2},
        "independence": {"type": "string", "minLength": 2}
      }
    },
    "evidence_ledger": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "as_of", "claims", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "evidence_ledger"},
        "as_of": {"type": "string", "minLength": 8},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "limitations": {"type": "array"}
      }
    },
    "competition_item": {
      "type": "object",
      "required": ["name", "category", "why_comparable", "evidence_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 2},
        "why_comparable": {"type": "string", "minLength": 12},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "competition_map": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "target", "customer_journey", "clusters", "target_position"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "competition_map"},
        "target": {"type": "string", "minLength": 1},
        "customer_journey": {"type": "array", "minItems": 3},
        "clusters": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "included", "searched_but_excluded", "search_terms", "stop_reason"], "properties": {"name": {"type": "string", "minLength": 2}, "included": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competition_item"}}, "searched_but_excluded": {"type": "array"}, "search_terms": {"type": "array", "minItems": 1}, "stop_reason": {"type": "string", "minLength": 12}}}},
        "target_position": {"type": "string", "minLength": 20}
      }
    },
    "argument_chain": {
      "type": "object",
      "required": ["conclusion", "mechanism", "evidence", "investment_implication", "boundary"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 4},
        "mechanism": {"type": "string", "minLength": 4},
        "evidence": {"type": "string", "minLength": 4},
        "investment_implication": {"type": "string", "minLength": 4},
        "boundary": {"type": "string", "minLength": 4}
      }
    },
    "investment_point": {
      "type": "object",
      "required": ["title", "thesis", "evidence_ids", "failure_conditions", "diligence_actions"],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "thesis": {"type": "string", "minLength": 20},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "failure_conditions": {"type": "array", "minItems": 1},
        "diligence_actions": {"type": "array", "minItems": 1}
      }
    },
    "narrative_section": {
      "type": "object",
      "required": ["id", "title", "paragraphs", "argument_chain", "evidence_ids", "table_justification"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
        "title": {"type": "string", "minLength": 8},
        "paragraphs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 70}},
        "argument_chain": {"$ref": "#/$defs/argument_chain"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "table_justification": {"type": "string"},
        "visualizations": {"type": "array"}
      }
    },
    "narrative_draft": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "central_thesis", "argument_sequence", "investment_points", "sections", "tracking_items", "editorial_checks"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "narrative_draft"},
        "central_thesis": {"type": "string", "minLength": 30},
        "argument_sequence": {"type": "array", "minItems": 2},
        "investment_points": {"type": "array", "items": {"$ref": "#/$defs/investment_point"}},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/narrative_section"}},
        "tracking_items": {"type": "array"},
        "editorial_checks": {"type": "object", "required": ["scaffolding_hidden", "paragraphs_connected", "tables_only_when_necessary", "reader_can_follow_top_to_bottom"]}
      }
    },
    "visualization_record": {
      "type": "object",
      "required": ["id", "sheet", "type", "evidence_ids", "data_range", "source_urls", "qa_status", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "sheet": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 2},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}},
        "data_range": {"type": "string"},
        "source_urls": {"type": "array"},
        "qa_status": {"enum": ["passed", "not_applicable"]},
        "limitations": {"type": "string"}
      }
    },
    "delivery_check": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "file_path", "format", "sheets", "rendered_sheets", "clipped_text", "missing_links", "formula_errors", "visual_repairs", "visualizations", "passed"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "delivery_check"},
        "file_path": {"type": "string", "minLength": 3},
        "format": {"enum_ref": "format"},
        "sheets": {"type": "array", "minItems": 1},
        "rendered_sheets": {"type": "array", "minItems": 1},
        "clipped_text": {"type": "array"},
        "missing_links": {"type": "array"},
        "formula_errors": {"type": "array"},
        "visual_repairs": {"type": "array"},
        "visualizations": {"type": "array", "items": {"$ref": "#/$defs/visualization_record"}},
        "passed": {"const": true}
      }
    },
    "research_record": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "brief_file", "completed_at", "deliverable_path", "routing", "key_conclusions", "coverage", "stage_artifacts", "quality_checks", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "research_record"},
        "brief_file": {"type": "string", "minLength": 3},
        "completed_at": {"type": "string", "minLength": 8},
        "deliverable_path": {"type": "string", "minLength": 3},
        "routing": {"$ref": "#/$defs/routing"},
        "key_conclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "evidence_ids"],
            "properties": {
              "text": {"type": "string", "minLength": 12},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["required_sections", "completed_sections", "competition_clusters", "source_counts_by_tier"],
          "properties": {
            "required_sections": {"type": "array"},
            "completed_sections": {"type": "array"},
            "competition_clusters": {"type": "array"},
            "source_counts_by_tier": {"type": "object", "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "integer"}, "B": {"type": "integer"}, "C": {"type": "integer"}, "D": {"type": "integer"}}}
          }
        },
        "stage_artifacts": {
          "type": "object",
          "required": ["brief", "evidence_ledger", "competition_map", "narrative_draft", "delivery_check"],
          "properties": {"brief": {"type": "string", "minLength": 1}, "evidence_ledger": {"type": "string", "minLength": 1}, "competition_map": {"type": "string", "minLength": 1}, "narrative_draft": {"type": "string", "minLength": 1}, "delivery_check": {"type": "string", "minLength": 1}}
        },
        "quality_checks": {
          "type": "object",
          "required": ["market_scope_separated", "investment_points_titled", "counterevidence_present", "primary_market_metrics_realistic", "narrative_contract_passed", "content_contract_passed", "artifact_reconciliation_passed", "all_sheets_rendered"],
          "properties": {"market_scope_separated": {"type": "boolean"}, "investment_points_titled": {"type": "boolean"}, "counterevidence_present": {"type": "boolean"}, "primary_market_metrics_realistic": {"type": "boolean"}, "narrative_contract_passed": {"type": "boolean"}, "content_contract_passed": {"type": "boolean"}, "artifact_reconciliation_passed": {"type": "boolean"}, "all_sheets_rendered": {"type": "boolean"}}
        },
        "limitations": {"type": "array"}
      }
    }
  }
}
