{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-industry-research-artifacts-v3",
  "schema_version": 3,
  "closed_objects": true,
  "enums": {
    "research_mode": ["industry_overview", "public_company", "private_company", "competitive_scan"],
    "deliverable": ["Excel"],
    "capital_market_stage": ["primary_market", "secondary_market", "not_applicable"],
    "research_subject": ["industry", "company"],
    "industry_orientation": ["consumer", "technology", "hybrid"],
    "listing_status": ["listed", "unlisted", "not_applicable"],
    "company_maturity": ["早期验证", "增长期", "成熟未上市", "拟上市", "上市运营", "不适用"],
    "information_availability": ["稀疏", "部分", "充分"],
    "output_profile": [
      "industry_consumer", "industry_technology", "industry_hybrid",
      "primary_consumer_company", "primary_technology_company", "primary_hybrid_company",
      "secondary_consumer_company", "secondary_technology_company", "secondary_hybrid_company"
    ],
    "evidence_type": ["fact", "reported_fact", "company_claim", "forecast", "estimate", "inference", "judgment", "to_verify"],
    "tier": ["A", "B", "C", "D"],
    "format": ["Excel"]
  },
  "$defs": {
    "evidence_ref": {"type": "string", "pattern": "^E[0-9]{2,4}$"},
    "routing": {
      "type": "object",
      "required": ["research_mode", "capital_market_stage", "research_subject", "industry_orientation", "analysis_dimensions", "listing_status", "listing_exchange", "ticker", "company_maturity", "information_availability", "output_profile", "orientation_rationale"],
      "properties": {
        "research_mode": {"enum_ref": "research_mode"},
        "capital_market_stage": {"enum_ref": "capital_market_stage"},
        "research_subject": {"enum_ref": "research_subject"},
        "industry_orientation": {"enum_ref": "industry_orientation"},
        "analysis_dimensions": {"type": "array", "minItems": 1, "items": {"enum": ["consumer", "technology", "integration"]}},
        "listing_status": {"enum_ref": "listing_status"},
        "listing_exchange": {"type": "string"},
        "ticker": {"type": "string"},
        "company_maturity": {"enum_ref": "company_maturity"},
        "information_availability": {"enum_ref": "information_availability"},
        "output_profile": {"enum_ref": "output_profile"},
        "orientation_rationale": {"type": "string", "minLength": 8}
      }
    },
    "brief": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "industry_theme", "deliverable", "routing", "scope", "decision_question", "core_hypothesis", "mode_rationale", "disproof_conditions", "must_cover_clusters", "required_sections", "output_acceptance"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "brief"},
        "industry_theme": {"type": "string", "minLength": 2},
        "target_company": {"type": "string"},
        "deliverable": {"enum_ref": "deliverable"},
        "routing": {"$ref": "#/$defs/routing"},
        "scope": {"type": "object", "required": ["geography", "as_of"], "properties": {"geography": {"type": "array", "minItems": 1}, "as_of": {"type": "string", "minLength": 8}, "segments": {"type": "array"}}},
        "decision_question": {"type": "string", "minLength": 8},
        "core_hypothesis": {"type": "string", "minLength": 20},
        "mode_rationale": {"type": "string", "minLength": 8},
        "disproof_conditions": {"type": "array", "minItems": 1},
        "must_cover_clusters": {"type": "array", "minItems": 1},
        "required_sections": {"type": "array", "minItems": 1},
        "output_acceptance": {"type": "array", "minItems": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "claim", "evidence_type", "tier", "source_name", "source_title", "published_at", "url", "geography", "period", "unit", "scope", "calculation", "usage", "limitations", "source_role", "independence"],
      "properties": {
        "id": {"$ref": "#/$defs/evidence_ref"},
        "claim": {"type": "string", "minLength": 12},
        "evidence_type": {"enum_ref": "evidence_type"},
        "tier": {"enum_ref": "tier"},
        "source_name": {"type": "string", "minLength": 2},
        "source_title": {"type": "string", "minLength": 2},
        "published_at": {"type": "string", "minLength": 4},
        "url": {"type": "string", "pattern": "^https?://"},
        "geography": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 2},
        "calculation": {"type": "string", "minLength": 2},
        "usage": {"type": "string", "minLength": 2},
        "limitations": {"type": "string", "minLength": 2},
        "source_role": {"type": "string", "minLength": 2},
        "independence": {"type": "string", "minLength": 2}
      }
    },
    "evidence_ledger": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "as_of", "claims", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "evidence_ledger"},
        "as_of": {"type": "string", "minLength": 8},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "limitations": {"type": "array"}
      }
    },
    "analysis_finding": {
      "type": "object",
      "required": ["title", "conclusion", "evidence_ids", "boundary", "open_questions"],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "conclusion": {"type": "string", "minLength": 20},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "boundary": {"type": "string", "minLength": 8},
        "open_questions": {"type": "array"}
      }
    },
    "stage_handoff": {
      "type": "object",
      "required": ["summary", "key_evidence_ids", "unresolved_questions", "completed_sections", "next_stage_focus"],
      "properties": {
        "summary": {"type": "string", "minLength": 30},
        "key_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "unresolved_questions": {"type": "array"},
        "completed_sections": {"type": "array", "minItems": 1},
        "next_stage_focus": {"type": "array", "minItems": 1}
      }
    },
    "industry_analysis": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "central_question", "findings", "counterevidence", "handoff", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "industry_analysis"},
        "central_question": {"type": "string", "minLength": 8},
        "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "counterevidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "handoff": {"$ref": "#/$defs/stage_handoff"},
        "limitations": {"type": "array"}
      }
    },
    "company_analysis": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "target_company", "relationship_to_industry", "findings", "counterevidence", "handoff", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "company_analysis"},
        "target_company": {"type": "string", "minLength": 1},
        "relationship_to_industry": {"type": "string", "minLength": 20},
        "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "counterevidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "handoff": {"$ref": "#/$defs/stage_handoff"},
        "limitations": {"type": "array"}
      }
    },
    "conflict_resolution": {
      "type": "object",
      "required": ["issue", "positions", "resolution", "evidence_ids", "remaining_uncertainty"],
      "properties": {
        "issue": {"type": "string", "minLength": 8},
        "positions": {"type": "array", "minItems": 2},
        "resolution": {"type": "string", "minLength": 20},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "remaining_uncertainty": {"type": "string", "minLength": 4}
      }
    },
    "section_blueprint": {
      "type": "object",
      "required": ["title", "purpose", "evidence_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "purpose": {"type": "string", "minLength": 12},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "analysis_synthesis": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "central_thesis", "decision_answer", "industry_conclusions", "company_conclusions", "conflicts", "counterevidence", "disproof_conditions", "section_blueprint", "handoff"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "analysis_synthesis"},
        "central_thesis": {"type": "string", "minLength": 30},
        "decision_answer": {"type": "string", "minLength": 30},
        "industry_conclusions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "company_conclusions": {"type": "array", "items": {"$ref": "#/$defs/analysis_finding"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict_resolution"}},
        "counterevidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analysis_finding"}},
        "disproof_conditions": {"type": "array", "minItems": 1},
        "section_blueprint": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/section_blueprint"}},
        "handoff": {"$ref": "#/$defs/stage_handoff"}
      }
    },
    "competition_item": {
      "type": "object",
      "required": ["name", "category", "why_comparable", "evidence_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 2},
        "why_comparable": {"type": "string", "minLength": 12},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "competition_map": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "target", "customer_journey", "clusters", "target_position"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "competition_map"},
        "target": {"type": "string", "minLength": 1},
        "customer_journey": {"type": "array", "minItems": 3},
        "clusters": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "included", "searched_but_excluded", "search_terms", "stop_reason"], "properties": {"name": {"type": "string", "minLength": 2}, "included": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competition_item"}}, "searched_but_excluded": {"type": "array"}, "search_terms": {"type": "array", "minItems": 1}, "stop_reason": {"type": "string", "minLength": 12}}}},
        "target_position": {"type": "string", "minLength": 20}
      }
    },
    "argument_chain": {
      "type": "object",
      "required": ["conclusion", "mechanism", "evidence", "investment_implication", "boundary"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 4},
        "mechanism": {"type": "string", "minLength": 4},
        "evidence": {"type": "string", "minLength": 4},
        "investment_implication": {"type": "string", "minLength": 4},
        "boundary": {"type": "string", "minLength": 4}
      }
    },
    "investment_point": {
      "type": "object",
      "required": ["title", "thesis", "evidence_ids", "failure_conditions", "diligence_actions"],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "thesis": {"type": "string", "minLength": 20},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "failure_conditions": {"type": "array", "minItems": 1},
        "diligence_actions": {"type": "array", "minItems": 1}
      }
    },
    "narrative_section": {
      "type": "object",
      "required": ["id", "title", "paragraphs", "argument_chain", "evidence_ids", "table_justification"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
        "title": {"type": "string", "minLength": 8},
        "paragraphs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 70}},
        "argument_chain": {"$ref": "#/$defs/argument_chain"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "table_justification": {"type": "string"},
        "visualizations": {"type": "array"}
      }
    },
    "narrative_draft": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "central_thesis", "argument_sequence", "investment_points", "sections", "tracking_items", "editorial_checks"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "narrative_draft"},
        "central_thesis": {"type": "string", "minLength": 30},
        "argument_sequence": {"type": "array", "minItems": 2},
        "investment_points": {"type": "array", "items": {"$ref": "#/$defs/investment_point"}},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/narrative_section"}},
        "tracking_items": {"type": "array"},
        "editorial_checks": {"type": "object", "required": ["scaffolding_hidden", "paragraphs_connected", "tables_only_when_necessary", "reader_can_follow_top_to_bottom"]}
      }
    },
    "visualization_record": {
      "type": "object",
      "required": ["id", "sheet", "type", "evidence_ids", "data_range", "source_urls", "qa_status", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "sheet": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 2},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}},
        "data_range": {"type": "string"},
        "source_urls": {"type": "array"},
        "qa_status": {"enum": ["passed", "not_applicable"]},
        "limitations": {"type": "string"}
      }
    },
    "completion_table": {
      "type": "object",
      "required": ["title", "columns", "rows", "evidence_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "columns": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "completion_module": {
      "type": "object",
      "required": ["id", "title", "status", "required_elements", "covered_elements", "missing_elements", "analysis", "evidence_ids", "source_artifacts", "tables"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "title": {"type": "string", "minLength": 4},
        "status": {"enum": ["complete", "incomplete", "not_applicable"]},
        "required_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "covered_elements": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "missing_elements": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "analysis": {"type": "string", "minLength": 80},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "source_artifacts": {"type": "array", "minItems": 1, "items": {"enum": ["evidence_ledger", "industry_analysis", "company_analysis", "competition_map", "analysis_synthesis", "narrative_draft"]}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/completion_table"}}
      }
    },
    "completion_audit": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "contract_version", "output_profile", "status", "modules", "blocking_gaps"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "completion_audit"},
        "contract_version": {"const": 1},
        "output_profile": {"enum_ref": "output_profile"},
        "status": {"enum": ["complete", "incomplete"]},
        "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/completion_module"}},
        "blocking_gaps": {"type": "array", "items": {"type": "string", "minLength": 2}}
      }
    },
    "module_location": {
      "type": "object",
      "required": ["module_id", "sheet", "range", "content_type", "evidence_ids"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "sheet": {"type": "string", "minLength": 1},
        "range": {"type": "string", "minLength": 3},
        "content_type": {"enum": ["narrative", "table", "narrative_and_table"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "narrative_location": {
      "type": "object",
      "required": ["section_id", "sheet", "range", "evidence_ids"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "range": {"type": "string", "minLength": 3},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "delivery_check": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "file_path", "format", "sheets", "rendered_sheets", "clipped_text", "missing_links", "formula_errors", "visual_repairs", "visualizations", "module_locations", "narrative_locations", "passed"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "delivery_check"},
        "file_path": {"type": "string", "minLength": 3},
        "format": {"enum_ref": "format"},
        "sheets": {"type": "array", "minItems": 1},
        "rendered_sheets": {"type": "array", "minItems": 1},
        "clipped_text": {"type": "array"},
        "missing_links": {"type": "array"},
        "formula_errors": {"type": "array"},
        "visual_repairs": {"type": "array"},
        "visualizations": {"type": "array", "items": {"$ref": "#/$defs/visualization_record"}},
        "module_locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module_location"}},
        "narrative_locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/narrative_location"}},
        "passed": {"const": true}
      }
    },
    "research_record": {
      "type": "object",
      "required": ["schema_version", "artifact_type", "brief_file", "completed_at", "deliverable_path", "routing", "key_conclusions", "coverage", "stage_artifacts", "quality_checks", "limitations"],
      "properties": {
        "schema_version": {"const": 3},
        "artifact_type": {"const": "research_record"},
        "brief_file": {"type": "string", "minLength": 3},
        "completed_at": {"type": "string", "minLength": 8},
        "deliverable_path": {"type": "string", "minLength": 3},
        "routing": {"$ref": "#/$defs/routing"},
        "key_conclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "evidence_ids"],
            "properties": {
              "text": {"type": "string", "minLength": 12},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["required_sections", "completed_sections", "competition_clusters", "source_counts_by_tier"],
          "properties": {
            "required_sections": {"type": "array"},
            "completed_sections": {"type": "array"},
            "competition_clusters": {"type": "array"},
            "source_counts_by_tier": {"type": "object", "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "integer"}, "B": {"type": "integer"}, "C": {"type": "integer"}, "D": {"type": "integer"}}}
          }
        },
        "stage_artifacts": {
          "type": "object",
          "required": ["brief", "evidence_ledger", "industry_analysis", "company_analysis", "competition_map", "analysis_synthesis", "narrative_draft", "completion_audit", "delivery_check"],
          "properties": {"brief": {"type": "string", "minLength": 1}, "evidence_ledger": {"type": "string", "minLength": 1}, "industry_analysis": {"type": "string", "minLength": 1}, "company_analysis": {"type": "string"}, "competition_map": {"type": "string", "minLength": 1}, "analysis_synthesis": {"type": "string", "minLength": 1}, "narrative_draft": {"type": "string", "minLength": 1}, "completion_audit": {"type": "string", "minLength": 1}, "delivery_check": {"type": "string", "minLength": 1}}
        },
        "quality_checks": {
          "type": "object",
          "required": ["market_scope_separated", "investment_points_titled", "counterevidence_present", "primary_market_metrics_realistic", "industry_gate_passed", "company_gate_passed_or_not_applicable", "synthesis_gate_passed", "editorial_used_synthesis_only", "narrative_contract_passed", "content_contract_passed", "module_completion_passed", "artifact_reconciliation_passed", "all_sheets_rendered"],
          "properties": {"market_scope_separated": {"type": "boolean"}, "investment_points_titled": {"type": "boolean"}, "counterevidence_present": {"type": "boolean"}, "primary_market_metrics_realistic": {"type": "boolean"}, "industry_gate_passed": {"type": "boolean"}, "company_gate_passed_or_not_applicable": {"type": "boolean"}, "synthesis_gate_passed": {"type": "boolean"}, "editorial_used_synthesis_only": {"type": "boolean"}, "narrative_contract_passed": {"type": "boolean"}, "content_contract_passed": {"type": "boolean"}, "module_completion_passed": {"type": "boolean"}, "artifact_reconciliation_passed": {"type": "boolean"}, "all_sheets_rendered": {"type": "boolean"}}
        },
        "limitations": {"type": "array"}
      }
    }
  }
}
